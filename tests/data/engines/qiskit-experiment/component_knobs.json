{
  "version": 1,
  "engine": {
    "examples": [
      {
        "path": "examples/tutorials/qiskit_cutting/automatic.yaml",
        "step": 1,
        "fields": [
          "cores",
          "experiment"
        ]
      },
      {
        "path": "examples/tutorials/qiskit_experiment/bksf_graph.yaml",
        "step": 1,
        "fields": [
          "max_output_bytes"
        ]
      }
    ],
    "guards": [
      {
        "fields": [
          "device"
        ],
        "reason": "CUDA and unsupported device combinations fail during experiment preflight.",
        "tests": [
          "tests/test_engines_qiskit_experiment.py::test_invalid_experiments_fail_before_publication"
        ]
      },
      {
        "fields": [
          "backend_python"
        ],
        "reason": "A custom worker interpreter uses the shared job-rendering and provisioning contract.",
        "tests": [
          "tests/test_engines_qiskit_experiment.py::test_artifact_engine_schedules_real_worker_and_preserves_scratch_payloads"
        ]
      }
    ],
    "internal": []
  },
