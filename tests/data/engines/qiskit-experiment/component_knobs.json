      "guards": [
        {
          "fields": [
            "cutting.max_exact_terms",
            "cutting.max_generated_instructions",
            "cutting.max_total_shots",
            "cutting.max_working_bytes"
          ],
          "reason": "Allocation and transport limits are tested at rejection and batching boundaries.",
          "tests": [
            "tests/test_engines_qiskit_cutting.py::test_prospective_cutting_budget_rejections"
          ]
        },
        {
          "fields": [
            "cutting.max_input_instructions",
            "cutting.max_observables"
          ],
          "reason": "Allocation and transport limits are tested at rejection and batching boundaries.",
          "tests": [
            "tests/test_engines_qiskit_cutting.py::test_cutting_rejects_embedded_markers_and_remaining_input_limits"
          ]
        },
        {
          "fields": [
            "cutting.max_input_qubits"
          ],
          "reason": "Allocation and transport limits are tested at rejection and batching boundaries.",
          "tests": [
            "tests/test_engines_qiskit_cutting.py::test_original_index_and_domain_guards"
          ]
        },
        {
          "fields": [
            "cutting.max_qpy_bytes",
            "cutting.worker_timeout_seconds"
          ],
          "reason": "Allocation and transport limits are tested at rejection and batching boundaries.",
          "tests": [
            "tests/test_engines_qiskit_cutting.py::test_planning_timeout_and_failure_are_config_errors"
          ]
        },
        {
          "fields": [
            "cutting.max_subexperiments"
          ],
          "reason": "Allocation and transport limits are tested at rejection and batching boundaries.",
          "tests": [
            "tests/test_engines_qiskit_cutting.py::test_partition_and_record_descriptor_budgets_precede_generation"
          ]
        },
        {
          "fields": [
            "cutting.publications_per_job"
          ],
          "reason": "Allocation and transport limits are tested at rejection and batching boundaries.",
          "tests": [
            "tests/test_engines_qiskit_cutting.py::test_typed_aer_memory_guard_and_publication_batches"
          ]
        }
      ],
      "internal": []
    },
